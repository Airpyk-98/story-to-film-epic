rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users/{userId} and nested subcollections users/{userId}/{document=**}
//   - Includes users/{userId}/settings/credentials and users/{userId}/drafts/current
//   - Strictly private to the authenticated Google owner (request.auth.uid == userId)
//
// Collection: automations/{jobId}
// Document ID: High-entropy unique job identifier (e.g., job_1761510000_x9f8a7b6c5d4)
// Fields:
//   - owner_uid: string (required, immutable, 1..128 chars) - UID of the job owner
//   - status: string (optional, <= 64 chars) - Current job status (queued, running, completed, failed, cancelled)
//   - step: string (optional, <= 256 chars) - Current pipeline milestone step
//   - message: string (optional, <= 5000 chars) - Live status message from worker
//   - progress: number (optional, 0..100) - Completion percentage
//   - cancel_requested: bool (optional) - Cancellation flag polled by Kaggle T4 worker
//   - created_at: timestamp or string or number (optional) - Job creation timestamp
//   - updated_at: timestamp or string or number (optional) - Last milestone update timestamp
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && resource.data.owner_uid == request.auth.uid;
    }

    function uidUnchanged() {
      return 'owner_uid' in request.resource.data &&
             request.resource.data.owner_uid is string &&
             request.resource.data.owner_uid == request.auth.uid;
    }

    function uidNotModified() {
      return 'owner_uid' in request.resource.data &&
             'owner_uid' in resource.data &&
             request.resource.data.owner_uid == resource.data.owner_uid;
    }

    function isValidOptionalString(field, maxLen) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == null ||
             (request.resource.data[field] is string &&
              request.resource.data[field].size() <= maxLen);
    }

    // Domain Validator for Automation Jobs
    function isValidAutomation(data) {
      return 'owner_uid' in data &&
             data.owner_uid is string &&
             data.owner_uid.size() > 0 &&
             data.owner_uid.size() <= 128 &&
             isValidOptionalString('status', 64) &&
             isValidOptionalString('step', 256) &&
             isValidOptionalString('message', 5000);
    }

    // ===============================================================
    // User Private Data & Subcollections (/users/{userId}/**)
    // ===============================================================
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ===============================================================
    // Automation Jobs (/automations/{jobId})
    // ===============================================================
    match /automations/{jobId} {
      // Only the authenticated user can create an automation job owned by their UID
      allow create: if isAuthenticated() &&
                       uidUnchanged() &&
                       isValidAutomation(request.resource.data);

      // Only the authenticated owner can list/query their own automation jobs
      allow list: if isDocOwner();

      // Only the authenticated owner can delete their own automation jobs
      allow delete: if isDocOwner();

      // Owner can read; direct single-document get by high-entropy jobId is allowed
      // so the headless Kaggle T4 GPU worker can poll cancel_requested via REST API
      // even if a short-lived auth token expires during a long multi-scene render.
      allow get: if isDocOwner() || true;

      // Owner or headless Kaggle T4 GPU worker (via high-entropy jobId) can update
      // job milestones, provided owner_uid remains immutable and valid.
      allow update: if ((isDocOwner() && uidNotModified()) || uidNotModified()) &&
                       isValidAutomation(request.resource.data);
    }

    // ===============================================================
    // Default Deny All Other Paths
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
